{
  "name": "paseo-command",
  "private": true,
  "type": "module",
  "description": "Paseo Command: the Paseo fleet drawn as the Atlas world (SpriteKit in the macOS app)",
  "scripts": {
    "build": "node phaser/bin/bake.mjs build game dist",
    "smoke": "node phaser/bin/bake.mjs smoke game",
    "play": "node phaser/bin/bake.mjs play game",
    "look": "node phaser/bin/bake.mjs look game",
    "check": "node phaser/bin/bake.mjs check game",
    "bake": "node phaser/bin/bake.mjs game",
    "typecheck": "node phaser/node_modules/typescript/bin/tsc -p game --noEmit",
    "serve": "npm run build && node scripts/serve-world.mjs",
    "app:install": "npm --prefix rendering install && npm --prefix web install",
    "app:dev": "npm --prefix web run dev",
    "app:build": "npm run render:test && npm --prefix web run build",
    "app:typecheck": "npm --prefix web run typecheck",
    "render:install": "npm --prefix rendering install",
    "render:test": "node --experimental-strip-types --test rendering/tests/*.test.mjs",
    "app:test": "npm --prefix web test",
    "app:e2e": "npm --prefix web run e2e",
    "app:start": "node scripts/app-server.mjs start",
    "app:stop": "node scripts/app-server.mjs stop",
    "app:restart": "node scripts/app-server.mjs restart",
    "app:status": "node scripts/app-server.mjs status",
    "app:update": "npm run app:build && npm run app:restart && npm run native:build",
    "native:build": "sh native/scripts/bundle.sh",
    "native:run": "sh native/scripts/run.sh",
    "native:mock": "web/node_modules/.bin/tsx native/scripts/mock-fleet.ts"
  }
}
