{
  "name": "paseo-command-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4310",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "bundle:server": "node scripts/bundle-server.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4310",
    "test": "tsx --test --import ./server/test-setup.ts \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "e2e": "tsx --test --import ./server/test-setup.ts --test-concurrency=1 e2e/*.e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@getpaseo/client": "^0.13.0-beta.1",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "^1.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@typesafe-ai/sdk": "^0.7.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "MIT"
}
